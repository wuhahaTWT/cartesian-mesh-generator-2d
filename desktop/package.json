{
  "name": "cartmesh2d-desktop",
  "version": "0.4.41",
  "private": true,
  "description": "Desktop shell for the native cartmesh2d mesher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "build:native": "node scripts/build-native.js",
    "pack:mac": "electron-builder --mac dir zip",
    "pack:linux": "electron-builder --linux dir tar.gz",
    "pack:win": "electron-builder --win dir zip"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "com.zhuanz.cartmesh2d",
    "productName": "CartMesh2D",
    "beforePack": "scripts/before-pack.js",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/bin",
        "to": "bin"
      },
      {
        "from": "runtime/samples",
        "to": "samples"
      },
      {
        "from": "runtime/manifest.json",
        "to": "runtime-manifest.json"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "linux": {
      "category": "Science",
      "executableName": "cartmesh2d-desktop",
      "target": [
        "dir",
        "tar.gz"
      ]
    },
    "win": {
      "executableName": "CartMesh2D",
      "target": [
        "dir",
        "zip"
      ]
    },
    "electronDist": "node_modules/electron/dist"
  }
}
