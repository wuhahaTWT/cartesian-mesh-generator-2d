  "concreteCoreIntegration": {
    "returnValue": "FaceStressEvaluation2D: physical integrated Vector2D traction per face plus sparse 2x2 coefficient blocks indexed by source cell, affine prescribed-trace term, wall recovery geometry, and native own-response validity diagnostics.",
    "assembly": "Build sparse pattern from all actual stress coefficients before assembly, including QR second/third graph ring DOFs; assemble same-cell off-component terms into vector momentum block. Flux correction/source splitting must preserve the exact residual.",
    "response": "Extract pressure response from the complete 2x2 momentum block/operator used for prediction. A rank-full QR derivative can have negative scalar owner coefficients; retaining or clamping a fabricated scalar diagonal is not a validated response.",
    "reuse": "Cache only geometry and boundary masks per immutable equation context. Keep live field/trace values, homogeneous affine evaluation, and accepted-step state distinct. Share wall traction exactly between residual, physical monitors and load output.",
    "acceptance": "Require same prescribed polygon trace semantics, physical curved-wall errors and neighboring small-grid trends in addition to polynomial reproduction and complete solver residuals. Failed response/rank must be explicit."
  }
