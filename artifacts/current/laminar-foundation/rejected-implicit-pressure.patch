diff --git a/include/cartmesh2d/fv/detail/PressureCorrection2D.hpp b/include/cartmesh2d/fv/detail/PressureCorrection2D.hpp
new file mode 100644
--- /dev/null
+++ b/include/cartmesh2d/fv/detail/PressureCorrection2D.hpp
@@ -0,0 +1,69 @@
+#pragma once
+
+#include "cartmesh2d/fv/detail/FlowFaceOperators2D.hpp"
+#include "cartmesh2d/fv/detail/FlowLinearSystem2D.hpp"
+
+namespace cartmesh2d::fv::detail {
+
+// Right-preconditioned restarted GMRES. Acceptance always uses the original
+// operator residual, not the preconditioned residual or the Hessenberg estimate.
+// The pressure operator includes least-squares nonorthogonal terms and is not
+// symmetric; PCG remains the solver for its orthogonal preconditioner only.
+template<class Apply, class Precondition>
+std::size_t solveCorrectedPressure2D(LinearVector2D& x,
+    const LinearVector2D& rhs, Apply apply, Precondition precondition, double stop) {
+    constexpr std::size_t restart=32, maximum=320;
+    const auto n=rhs.size();
+    LinearVector2D ax(n), residual(n);
+    std::size_t iterations=0;
+    while(iterations<maximum) {
+        apply(x,ax);
+        for(std::size_t i=0;i<n;++i)residual[i]=rhs[i]-ax[i];
+        const double beta=linearNorm(residual);
+        if(beta<=stop)return iterations;
+        std::vector<LinearVector2D> basis(1,residual), directions;
+        for(auto& value:basis[0])value/=beta;
+        double h[restart+1][restart]{}, cs[restart]{}, sn[restart]{}, g[restart+1]{};
+        g[0]=beta;
+        std::size_t count=0;
+        for(std::size_t j=0;j<restart && iterations<maximum;++j,++iterations) {
+            directions.emplace_back(n,0.);
+            precondition(basis[j],directions.back());
+            LinearVector2D w(n);apply(directions.back(),w);
+            // A second orthogonalization pass is needed for highly stretched
+            // cut cells and the nearly converged pressure correction.
+            for(int pass=0;pass<2;++pass)for(std::size_t k=0;k<=j;++k) {
+                const double projection=linearProduct(w,basis[k]);h[k][j]+=projection;
+                for(std::size_t i=0;i<n;++i)w[i]-=projection*basis[k][i];
+            }
+            h[j+1][j]=linearNorm(w);
+            const bool breakdown=h[j+1][j]==0;
+            if(!breakdown)for(auto& value:w)value/=h[j+1][j];
+            basis.push_back(std::move(w));
+            for(std::size_t k=0;k<j;++k) {
+                const double top=cs[k]*h[k][j]+sn[k]*h[k+1][j];
+                h[k+1][j]=-sn[k]*h[k][j]+cs[k]*h[k+1][j];h[k][j]=top;
+            }
+            const double length=std::hypot(h[j][j],h[j+1][j]);
+            linearEnsure(length>0 && std::isfinite(length),"Corrected pressure GMRES singular operator");
+            cs[j]=h[j][j]/length;sn[j]=h[j+1][j]/length;
+            h[j][j]=length;h[j+1][j]=0;
+            g[j+1]=-sn[j]*g[j];g[j]*=cs[j];count=j+1;
+            if(std::abs(g[j+1])<=stop || breakdown){++iterations;break;}
+        }
+        double y[restart]{};
+        for(std::size_t j=count;j-->0;) {
+            double value=g[j];
+            for(std::size_t k=j+1;k<count;++k)value-=h[j][k]*y[k];
+            y[j]=linearFinite(value/h[j][j]);
+        }
+        for(std::size_t j=0;j<count;++j)
+            for(std::size_t i=0;i<n;++i)x[i]+=y[j]*directions[j][i];
+    }
+    apply(x,ax);
+    for(std::size_t i=0;i<n;++i)residual[i]=rhs[i]-ax[i];
+    if(linearNorm(residual)<=stop)return iterations;
+    throw std::runtime_error("Corrected pressure GMRES iteration limit reached");
+}
+
+} // namespace cartmesh2d::fv::detail
