{
  "schema": "cartmesh2d-native-laminar-closed-schur-v1",
  "baseCommit": "cef44f0a1b6c58c5ca09213de2fb85179e6d43a9",
  "scope": "Enable the existing pressure Schur IC0 and fixed aggregation inverse for connected closed-domain compatible flow, retaining the original last-cell pressure gauge and complete continuity check. No default, mesh, equation, boundary, checkpoint scheme or tolerance changes.",
  "method": {
    "pressureCoordinates": "The original assembly already eliminates the final pressure coordinate in a closed domain. Gauge Schur builds B diag(Apicard)^-1 G on exactly those retained coordinates; it must not apply the mass inverse rank-one correction again.",
    "emptyPressureBlock": "One closed cell with free tangential traces can have velocity unknowns but zero retained pressure unknowns. Skip the empty auxiliary pressure solve, retaining the actual velocity solve and gauge-cell continuity residual.",
    "nativeConstraints": "No symmetrization, coefficient clipping, auxiliary iteration or fallback. Original exact-symmetry/nonpositive-off-diagonal hierarchy rules and positive pivot failures remain.",
    "controls": "nu=1 Stokes or nu=.1/.01 NS; U=L=1. NS initial pseudo step .1, Zero linear initial guess, ILU0, 50x60 linear budget, 1e-13 true linear and 1e-9 original equation/state controls.",
    "fieldNorms": "Native state comparator integrates all P1 cell components on the actual mesh; absolute pressure difference retains the common final-cell gauge. An additional whole-domain mean-removed norm is separately named.",
    "roundoffAllowance": "Existing 1e-7 polynomial API allowance in U,L units and existing 1e-10 CLI coefficient allowance are unchanged; neither is a spatial or physical acceptance threshold."
  },
