  "source": {
    "path": "artifacts/current/native-laminar-hybrid-stokes.cpp",
    "sha256": "9d82d6b2e5beef50fb0b4af88242cc0a51fbc0881caea64536e4dfc0e3e641d2",
    "fixture": "tests/flow_face_test.cpp",
    "fixture_sha256": "c7364ab94d75949f29ae06db6013ebc5871e9f3818e410e0204cf14589a79b1c"
  },
  "method": {
    "velocity_unknowns": "two cell-mean and two shared face-mean components; all boundary face means prescribed",
    "pressure_unknowns": "one cell mean; final cell pressure zero fixes the additive gauge",
    "gradient": "G_T=sum_F u_F tensor S_TF / area_T",
    "viscous_form": "nu*area_T*G:G + nu*sum_F length_F/diameter_T*|u_F-u_T-G*(c_F-c_T)|^2; nu=1 m^2/s",
    "coupling": "B_T u=sum_F S_TF dot u_F; momentum pressure block=-transpose(B); continuity=-B u=0",
    "force_moment": "For constant f_T, load f_T dot sum_F (c_F-c_T)*(v_F dot S_TF); also compare ordinary area_T*f_T dot v_T",
    "scope": "lowest-order hybrid Laplacian Stokes; no convection, physical time, traction outlet, pressure stabilisation or iterative solve",
    "linear_solver": "dense partial-pivot LU with exact-zero/nonfinite pivot rejection; 1500 unknown cost cap; actual residual reported, not a new CFD tolerance",
    "references": [
      {
        "url": "https://arxiv.org/html/2203.07180v3",
        "use": "cell/face HHO spaces, divergence-pressure pairing and divergence-preserving load motivation; this prototype does not implement the paper full subtriangulation reconstruction or Navier-Stokes method"
      }
    ]
  },
  "fixtures": {
    "square": "n*n cells on [0,1]^2; n=4,8,12",
    "sheared": "(x,y)->(x+0.7*y,y); n=4,8,12",
    "cut": "same [0,1]^2 grid clipped exactly to y>=0.127+0.31*x; area=0.718 m^2; intersections computed in canonical endpoint order; all positive-area polygons retained; n=8/12 rejected by unchanged native Solver gate",
    "split_face": "three native test polygons, with a collinear vertex giving two genuine shared faces on one coarse cell side",
    "triangular_tip": "four native test polygons including a one-face-neighbour triangular tip",
    "boundary_semantics": "manufactured Dirichlet velocity traces on every edge; only hydrostatic case has homogeneous closed no-penetration walls; affine/Poiseuille cut-boundary tests are not a stationary obstacle benchmark"
  },
  "analytical_controls": {
    "couette": "u=(y,0), p=constant, f=0",
    "rotation": "u=(-y,x), p=constant, f=0; affine Laplacian Stokes patch, not a Navier-Stokes rigid-rotation solution",
    "hydrostatic": "u=0, p=x+2y, f=(1,2); compare moment and ordinary cell load in this same prototype; not an old product comparison",
    "poiseuille": "u=(4*(y-y^2),0), p=-8*x, f=0; exact quadratic face/cell averages on each polygon",
    "error_definitions": "area-weighted cell-mean RMS; p error after removing global area-weighted additive gauge; all cells retained"
  },
  "units": {
    "velocity": "m/s",
    "pressure": "kinematic m^2/s^2",
    "mass_max": "max abs(sum outward q)/cell area, s^-1",
    "net_flux": "m^2/s",
    "pressure_work": "-sum_T p_T*(B_T u), m^4/s^3",
    "area": "m^2",
    "affine_moment_defect": "dimensionless max component error of sum_F (c_F-c_T) tensor S_TF / area_T relative to identity",
