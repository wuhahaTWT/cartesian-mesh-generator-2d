  "implementation": {
    "api": "evaluateCompatibleFlowLoads2D(mesh, controls, acceptedCheckpoint, momentOrigin)",
    "source": "Original uncondensed steady equations, same native pressure/viscosity/RT1 transport and actual lifted body-load integration; no Newton tangent or pseudo mass in the reported load.",
    "physicalTraction": "Face residual + prescribed traction + implicit transpose-gradient correction; add advective face momentum flux on prescribed full-velocity boundaries only. Mixed boundaries retain Cartesian reactions before constraint projection.",
    "moments": "Integrals against 1 and s in [-1/2,1/2], with physical face tangent (-Sy,Sx). P1 traction coefficients are moment0/length and 12*moment1/length.",
    "convention": "Positive on fluid with its outward normal. Opposite is force on adjacent body. Pressure moment is the direct -p*n integral; total-minus-pressure includes stabilization, transport reconstruction and lifted-load effects as well as viscosity.",
    "units": {
      "force": "m^3/s^2",
      "torque": "m^4/s^2",
      "volumeFlux": "m^2/s",
      "densityConversion": "Multiplying by density gives N/m force and N torque, both per unit out-of-plane depth."
    },
    "boundContext": "Same native discrete-context check as restart; arbitrary seed/rejected state is not a load-API input. Closed domains keep checkpoint pressure gauge and explicitly lack absolute pressure reference.",
    "cli": "Atomically publishes .loads.json from the last accepted checkpoint. Budget-limited reports remain nonconverged; no accepted state means no load file, cancellation skips new load work and preserves checkpoint. Existing load files are protected.",
    "defaultChange": false,
    "spatialAccuracyChange": false
  },
