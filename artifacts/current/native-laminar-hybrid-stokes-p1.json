  "method": {
    "spaces": "P1 cell velocity (6 DOFs/cell), P1 shared face velocity (4 DOFs/face), P1 cell pressure (3 DOFs/cell); exact prescribed face L2 velocity projections; final cell constant pressure coefficient fixes gauge",
    "geometry": "unchanged native fromPolygons/makeFvMesh2D; same true polygons as k=0; native Solver gate; no cell deletion or threshold change",
    "gradient": "P1 weak gradient: (G_i(v),q)_T=-(v_T,partial_i q)_T+sum_F(v_F*n_i,q)_F",
    "potential": "P2 local Neumann potential r with cell velocity mean: (grad r,grad w)_T=-(v_T,Laplacian w)_T+sum_F(v_F,normal derivative w)_F",
    "stabilisation": "face L2 projection of r-pi_T^1(r)+v_T-v_F, squared and scaled by nu*length_F/diameter_T; same diameter scaling as k=0",
    "viscosity": "nu=1 m^2/s; positive gradient-square plus stabilisation; Laplacian Stokes only",
    "divergence_pressure": "B uses P1 weak divergence with both cell and face moments; momentum pressure block exactly -B^T; all divergence moments enforced except one globally redundant mean",
    "force": "ordinary cell L2 load; no complete general pressure-robust H(div) reconstruction",
    "quadrature": "Gauss-Legendre order 8 on faces and signed centroid-edge triangle Duffy quadrature in cells; order 12 control on coarsest sheared vortex; signs preserve actual polygon integral",
    "solver": "dense partial-pivot LU, no nonzero pivot threshold, fail on zero/nonfinite pivot or solution; 2600 unknown cap controls prototype cost only",
    "reference": {
      "url": "https://arxiv.org/html/2203.07180v3",
      "use": "standard HHO polynomial spaces, weak gradient/divergence coupling and potential-consistent stabilisation; no claim to implement the paper complete pressure-robust Navier-Stokes method or inherit untested tiny-face estimates"
    }
  },
  "cases": {
    "meshes": "same square, shear0.7, exact half-plane-cut y>=0.127+0.31*x meshes at n2/4/8; native split face and triangular tip polygons",
    "polynomial": "couette u=(y,0); hydrostatic u0,p=x+2y,f=(1,2); Poiseuille u=(4y(1-y),0),p=-8x,f0; all exact manufactured Dirichlet boundary projections",
    "vortex": "u=(sin(pi*x)*cos(pi*y),-cos(pi*x)*sin(pi*y)); p=sin(pi*x)*sin(pi*y); Stokes f=2*pi^2*u+grad(p); all outer velocity traces prescribed",
    "closed_wall_scope": "hydrostatic has zero velocity on all walls; square vortex has exact no-penetration moving tangential walls; cut/sheared manufactured traces are not stationary obstacles",
    "rejection": "cut n8 failed the unchanged native Solver gate at geometry creation; no solves accepted on that mesh"
